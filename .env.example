# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"baza-poker","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"baza-sheets@baza-poker.iam.gserviceaccount.com"}'
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# ImgBB API Integration (for client and server uploads)
IMGBB_API_KEY="your_imgbb_api_key_here"
NEXT_PUBLIC_IMGBB_API_KEY="your_imgbb_api_key_here"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_SECRET_TOKEN="your_random_secret_token_here"

# Cron Secret for automated routes /api/cron/*
# CRON_SECRET: сгенерируйте случайную строку и добавьте в Vercel Project Settings → Environment Variables (Production)
CRON_SECRET="your_cron_secret_here"
# Set DEBUG_CRON="true" to enable recipient debug info in cron route responses when ?debug=1
DEBUG_CRON="false"

# App URL Configuration
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NOTIFICATIONS_APP_URL="https://your-domain.com"

# Web Push VAPID Keys
# Для генерации используйте команду: npm run generate:vapid (или node generate-vapid-keys.js)
# Затем добавьте NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT в Vercel (Production & Preview) и выполните Redeploy.
